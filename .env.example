# ===========================================
# Context Bridge - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration (required for MCP demo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# For local MCP worker (use service key - keep secret!)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anthropic/Claude API Key (for HelperMCP)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# HelperMCP LLM Configuration
HELPERMCP_LLM_PROVIDER=anthropic
HELPERMCP_LLM_MODEL=claude-sonnet-4-20250514

# ===========================================
# HOW TO GET THESE VALUES:
# ===========================================
# 1. Go to https://supabase.com/dashboard
# 2. Create a new project (free tier works)
# 3. Go to Settings > API
# 4. Copy:
#    - Project URL -> NEXT_PUBLIC_SUPABASE_URL
#    - anon/public key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role key -> SUPABASE_SERVICE_KEY (keep secret!)
# 5. Go to SQL Editor and run scripts/supabase_schema.sql
#
# For Anthropic API key:
# 1. Go to https://console.anthropic.com
# 2. Create an API key
# 3. Copy it to ANTHROPIC_API_KEY
